<Window x:Class="PlainToolkit.UI.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource PlainWindow}"
        Title="PlainToolkit.UI Gallery" Width="900" Height="700"
        Background="{DynamicResource ColorBrushBackground}"
        FontFamily="Segoe UI">
    <ScrollViewer Style="{DynamicResource PlainScrollViewerFullMargin}" Padding="20">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="PlainToolkit.UI Gallery" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource ColorBrush2}" Margin="0,0,0,4" />

            <TextBlock Text="Extracted from PCL-CE UI component styles"
                       FontSize="14" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,8" />

            <Separator Height="1" Background="{DynamicResource ColorBrush5}" Margin="0,4,0,16" />

            <!-- ============================================ -->
            <!-- 1. Color Palette Swatches -->
            <!-- ============================================ -->
            <TextBlock Text="Color Palette" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <WrapPanel Margin="0,0,0,24">
                <!-- Primary -->
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#343d4a" ToolTip="ColorBrush1 #343d4a" />
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#0b5bcb" ToolTip="ColorBrush2 #0b5bcb" />
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#1370f3" ToolTip="ColorBrush3 #1370f3" />
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#4890f5" ToolTip="ColorBrush4 #4890f5" />
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#96c0f9" ToolTip="ColorBrush5 #96c0f9" />
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#d5e6fd" ToolTip="ColorBrush6 #d5e6fd" />
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#e0eafd" ToolTip="ColorBrush7 #e0eafd" />
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#eaf2fe" ToolTip="ColorBrush8 #eaf2fe" />
                <!-- Gray -->
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#404040" ToolTip="Gray1 #404040" />
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#737373" ToolTip="Gray2 #737373" />
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#8c8c8c" ToolTip="Gray3 #8c8c8c" />
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#a6a6a6" ToolTip="Gray4 #a6a6a6" />
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#cccccc" ToolTip="Gray5 #cccccc" />
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#ebebeb" ToolTip="Gray6 #ebebeb" />
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#f0f0f0" ToolTip="Gray7 #f0f0f0" />
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#f5f5f5" ToolTip="Gray8 #f5f5f5" />
                <!-- Semantic -->
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#ff4c4c" ToolTip="RedLight #ff4c4c" />
                <Border Width="60" Height="40" CornerRadius="4" Margin="0,0,6,6"
                        Background="#ce2111" ToolTip="RedDark #ce2111" />
            </WrapPanel>

            <!-- ============================================ -->
            <!-- 2. Buttons -->
            <!-- ============================================ -->
            <TextBlock Text="Buttons" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Content="Normal" Style="{DynamicResource PlainButton}" Margin="0,0,12,0" Padding="14,8" />
                <Button Content="Primary" Style="{DynamicResource PlainButton}" Margin="0,0,12,0" Padding="14,8"
                        BorderBrush="{DynamicResource ColorBrush3}" />
                <Button Content="Danger" Style="{DynamicResource PlainButton}" Margin="0,0,12,0" Padding="14,8"
                        BorderBrush="{DynamicResource ColorBrushRedLight}" />
                <Button Content="Disabled" Style="{DynamicResource PlainButton}" Padding="14,8" IsEnabled="False" />
            </StackPanel>

            <!-- ============================================ -->
            <!-- 3. TextBox -->
            <!-- ============================================ -->
            <TextBlock Text="TextBox" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <StackPanel Margin="0,0,0,24" MaxWidth="400">
                <TextBlock Text="Default style:" Foreground="{DynamicResource ColorBrushGray3}"
                           FontSize="12" Margin="0,0,0,4" />
                <TextBox Style="{DynamicResource PlainTextBox}" Text="Hello PlainToolkit" Width="300"
                         HorizontalAlignment="Left" Margin="0,0,0,8" />
                <TextBox Style="{DynamicResource PlainTextBox}" Width="300" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- ============================================ -->
            <!-- 4. PasswordBox -->
            <!-- ============================================ -->
            <TextBlock Text="PasswordBox" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <PasswordBox Width="300" HorizontalAlignment="Left" Margin="0,0,0,24" />

            <!-- ============================================ -->
            <!-- 5. ComboBox -->
            <!-- ============================================ -->
            <TextBlock Text="ComboBox" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <ComboBox Style="{DynamicResource PlainComboBox}" Width="250" HorizontalAlignment="Left"
                      SelectedIndex="0" Margin="0,0,0,24">
                <ComboBoxItem Content="Option A" />
                <ComboBoxItem Content="Option B" />
                <ComboBoxItem Content="Option C" />
            </ComboBox>

            <!-- ============================================ -->
            <!-- 6. CheckBox / Radio -->
            <!-- ============================================ -->
            <TextBlock Text="CheckBox &amp; Radio" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <CheckBox Content="Check Me" IsChecked="True" Margin="0,0,24,0"
                          Foreground="{DynamicResource ColorBrush1}" FontSize="13" />
                <CheckBox Content="Unchecked" Margin="0,0,24,0"
                          Foreground="{DynamicResource ColorBrush1}" FontSize="13" />
                <RadioButton Content="Radio 1" IsChecked="True" Margin="0,0,24,0"
                             Foreground="{DynamicResource ColorBrush1}" FontSize="13" />
                <RadioButton Content="Radio 2"
                             Foreground="{DynamicResource ColorBrush1}" FontSize="13" />
            </StackPanel>

            <!-- ============================================ -->
            <!-- 7. Slider -->
            <!-- ============================================ -->
            <TextBlock Text="Slider" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <Slider Width="300" HorizontalAlignment="Left" Minimum="0" Maximum="100" Value="42"
                    Foreground="{DynamicResource ColorBrush3}" Margin="0,0,0,24" />

            <!-- ============================================ -->
            <!-- 8. ScrollBar (visible in this viewer) -->
            <!-- ============================================ -->
            <TextBlock Text="ScrollBar (in ScrollViewer)" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <Border BorderBrush="{DynamicResource ColorBrush5}" BorderThickness="1" CornerRadius="4"
                    Width="200" Height="80" Background="{DynamicResource ColorBrush8}" Margin="0,0,0,24">
                <ScrollViewer Style="{DynamicResource PlainScrollViewer}">
                    <StackPanel>
                        <TextBlock Text="Scroll item 1" FontSize="13" Margin="4" />
                        <TextBlock Text="Scroll item 2" FontSize="13" Margin="4" />
                        <TextBlock Text="Scroll item 3" FontSize="13" Margin="4" />
                        <TextBlock Text="Scroll item 4" FontSize="13" Margin="4" />
                        <TextBlock Text="Scroll item 5" FontSize="13" Margin="4" />
                        <TextBlock Text="Scroll item 6" FontSize="13" Margin="4" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================================ -->
            <!-- 9. ToggleButton -->
            <!-- ============================================ -->
            <TextBlock Text="ToggleButton" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <ToggleButton Style="{DynamicResource PlainToggleButton}" Width="150" Height="24"
                          Foreground="{DynamicResource ColorBrush1}" Content="Toggle Me"
                          Margin="0,0,0,24" />

            <!-- ============================================ -->
            <!-- 10. ToolTip -->
            <!-- ============================================ -->
            <TextBlock Text="ToolTip" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <TextBlock Text="Hover me for tooltip" FontSize="13" Margin="0,0,0,24"
                       ToolTip="This is a PlainToolkit.UI ToolTip style" />

            <!-- ============================================ -->
            <!-- 11. ContextMenu -->
            <!-- ============================================ -->
            <TextBlock Text="ContextMenu" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <TextBlock Text="Right-click for context menu" FontSize="13" Margin="0,0,0,24">
                <TextBlock.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Action 1" />
                        <MenuItem Header="Action 2" />
                        <Separator />
                        <MenuItem Header="Action 3" />
                    </ContextMenu>
                </TextBlock.ContextMenu>
            </TextBlock>

            <!-- ============================================ -->
            <!-- 12. Calendar -->
            <!-- ============================================ -->
            <TextBlock Text="Calendar" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <Calendar Width="260" Height="200" Margin="0,0,0,24" />

            <!-- ============================================ -->
            <!-- 13. ListBox -->
            <!-- ============================================ -->
            <TextBlock Text="ListBox" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <ListBox Width="300" HorizontalAlignment="Left" Margin="0,0,0,24">
                <ListBoxItem Content="Item 1" />
                <ListBoxItem Content="Item 2" />
                <ListBoxItem Content="Item 3 (selected)" IsSelected="True" />
                <ListBoxItem Content="Item 4" />
            </ListBox>

            <!-- ============================================ -->
            <!-- 14. ListView (GridView) -->
            <!-- ============================================ -->
            <TextBlock Text="ListView (GridView)" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <ListView Width="400" HorizontalAlignment="Left" Margin="0,0,0,24"
                      ItemsSource="{Binding SampleData}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="120" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Category" Width="100" DisplayMemberBinding="{Binding Category}" />
                        <GridViewColumn Header="Value" Width="80" DisplayMemberBinding="{Binding Value}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- ============================================ -->
            <!-- 15. DataGrid -->
            <!-- ============================================ -->
            <TextBlock Text="DataGrid" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <DataGrid Width="500" HorizontalAlignment="Left" Height="160" Margin="0,0,0,24"
                      ItemsSource="{Binding SampleData}"
                      AutoGenerateColumns="True" />

            <!-- ============================================ -->
            <!-- 16. TabControl -->
            <!-- ============================================ -->
            <TextBlock Text="TabControl" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />

            <TabControl Width="400" HorizontalAlignment="Left" Margin="0,0,0,24" Height="120">
                <TabItem Header="First Tab">
                    <TextBlock Text="Content of first tab" FontSize="13" Margin="8"
                               Foreground="{DynamicResource ColorBrush1}" />
                </TabItem>
                <TabItem Header="Second Tab">
                    <TextBlock Text="Content of second tab" FontSize="13" Margin="8"
                               Foreground="{DynamicResource ColorBrush1}" />
                </TabItem>
                <TabItem Header="Third Tab">
                    <TextBlock Text="Content of third tab" FontSize="13" Margin="8"
                               Foreground="{DynamicResource ColorBrush1}" />
                </TabItem>
            </TabControl>

            <!-- footer spacer -->
            <Rectangle Height="20" Fill="Transparent" />
        </StackPanel>
    </ScrollViewer>
</Window>

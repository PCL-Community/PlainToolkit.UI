<Window x:Class="PlainToolkit.UI.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource PlainWindow}"
        Title="PlainToolkit.UI Gallery" Width="960" Height="720"
        MinWidth="480" MinHeight="400"
        Background="{DynamicResource ColorBrushBackground}"
        FontFamily="Segoe UI">
    <ScrollViewer Style="{DynamicResource PlainScrollViewerFullMargin}" Padding="20">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="PlainToolkit.UI Gallery" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource ColorBrush2}" Margin="0,0,0,4" />
            <TextBlock Text="Extracted from PCL-CE — 22 styled controls with adaptive layout"
                       FontSize="14" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,16" />

            <!-- ============================================ -->
            <!-- Adaptive Card Grid -->
            <!-- ============================================ -->
            <WrapPanel>

                <!-- Color Palette -->
                <ContentControl Style="{StaticResource PlainCard}" Width="360" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Color Palette" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#343d4a" ToolTip="ColorBrush1 #343d4a" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#0b5bcb" ToolTip="ColorBrush2 #0b5bcb" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#1370f3" ToolTip="ColorBrush3 #1370f3" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#4890f5" ToolTip="ColorBrush4 #4890f5" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#96c0f9" ToolTip="ColorBrush5 #96c0f9" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#d5e6fd" ToolTip="ColorBrush6 #d5e6fd" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#e0eafd" ToolTip="ColorBrush7 #e0eafd" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#eaf2fe" ToolTip="ColorBrush8 #eaf2fe" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#404040" ToolTip="Gray1 #404040" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#737373" ToolTip="Gray2 #737373" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#8c8c8c" ToolTip="Gray3 #8c8c8c" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#a6a6a6" ToolTip="Gray4 #a6a6a6" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#cccccc" ToolTip="Gray5 #cccccc" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#ebebeb" ToolTip="Gray6 #ebebeb" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#f0f0f0" ToolTip="Gray7 #f0f0f0" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#f5f5f5" ToolTip="Gray8 #f5f5f5" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#ff4c4c" ToolTip="RedLight #ff4c4c" />
                            <Border Width="48" Height="32" CornerRadius="3" Margin="0,0,4,4"
                                    Background="#ce2111" ToolTip="RedDark #ce2111" />
                        </WrapPanel>
                    </StackPanel>
                </ContentControl>

                <!-- Buttons -->
                <ContentControl Style="{StaticResource PlainCard}" Width="360" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Button" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Content="Normal" Style="{DynamicResource PlainButton}"
                                    Margin="0,0,8,6" Padding="14,8" />
                            <Button Content="Primary" Style="{DynamicResource PlainButton}"
                                    Margin="0,0,8,6" Padding="14,8"
                                    BorderBrush="{DynamicResource ColorBrush3}" />
                            <Button Content="Danger" Style="{DynamicResource PlainButton}"
                                    Margin="0,0,8,6" Padding="14,8"
                                    BorderBrush="{DynamicResource ColorBrushRedLight}" />
                            <Button Content="Disabled" Style="{DynamicResource PlainButton}"
                                    Padding="14,8" IsEnabled="False" />
                        </WrapPanel>
                    </StackPanel>
                </ContentControl>

                <!-- CheckBox & Radio -->
                <ContentControl Style="{StaticResource PlainCard}" Width="360" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="CheckBox &amp; RadioButton" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                        <WrapPanel>
                            <CheckBox Content="Checked" IsChecked="True" Margin="0,0,16,6"
                                      Foreground="{DynamicResource ColorBrush1}" FontSize="13" />
                            <CheckBox Content="Unchecked" Margin="0,0,16,6"
                                      Foreground="{DynamicResource ColorBrush1}" FontSize="13" />
                            <CheckBox Content="Disabled" IsEnabled="False" Margin="0,0,16,6"
                                      Foreground="{DynamicResource ColorBrush1}" FontSize="13" />
                            <RadioButton Content="Radio 1" IsChecked="True" Margin="0,0,16,6"
                                         Foreground="{DynamicResource ColorBrush1}" FontSize="13" />
                            <RadioButton Content="Radio 2" Margin="0,0,16,6"
                                         Foreground="{DynamicResource ColorBrush1}" FontSize="13" />
                        </WrapPanel>
                    </StackPanel>
                </ContentControl>

                <!-- TextBox & PasswordBox -->
                <ContentControl Style="{StaticResource PlainCard}" Width="360" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="TextBox &amp; PasswordBox" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                        <TextBox Style="{DynamicResource PlainTextBox}" Text="Hello PlainToolkit"
                                 Margin="0,0,0,8" />
                        <TextBox Style="{DynamicResource PlainTextBox}" Margin="0,0,0,8" />
                        <PasswordBox Margin="0,0,0,8" />
                    </StackPanel>
                </ContentControl>

                <!-- ComboBox -->
                <ContentControl Style="{StaticResource PlainCard}" Width="360" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="ComboBox" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                        <ComboBox Style="{DynamicResource PlainComboBox}" SelectedIndex="0"
                                  Margin="0,0,0,8">
                            <ComboBoxItem Content="Option A" />
                            <ComboBoxItem Content="Option B" />
                            <ComboBoxItem Content="Option C" />
                        </ComboBox>
                        <ComboBox Style="{DynamicResource PlainComboBox}" IsEnabled="False"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Disabled" />
                        </ComboBox>
                    </StackPanel>
                </ContentControl>

                <!-- Slider -->
                <ContentControl Style="{StaticResource PlainCard}" Width="360" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Slider" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                        <Slider Width="280" Minimum="0" Maximum="100" Value="42"
                                Foreground="{DynamicResource ColorBrush2}" Margin="0,0,0,8" />
                        <Slider Width="280" Minimum="0" Maximum="100" Value="70" IsEnabled="False"
                                Foreground="{DynamicResource ColorBrush2}" />
                    </StackPanel>
                </ContentControl>

                <!-- ToggleButton -->
                <ContentControl Style="{StaticResource PlainCard}" Width="360" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="ToggleButton" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{DynamicResource PlainToggleButton}"
                                          Content="Toggle" Width="100" Height="28" Margin="0,0,12,0" />
                            <ToggleButton Style="{DynamicResource PlainToggleButton}"
                                          Content="Disabled" Width="100" Height="28" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>

                <!-- ToolTip & ContextMenu -->
                <ContentControl Style="{StaticResource PlainCard}" Width="360" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="ToolTip &amp; ContextMenu" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                        <TextBlock Text="Hover for tooltip" FontSize="13" Margin="0,0,0,8"
                                   ToolTip="This is a PlainToolkit.UI ToolTip" />
                        <TextBlock Text="Right-click for context menu" FontSize="13">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Action 1" />
                                    <MenuItem Header="Action 2" />
                                    <Separator />
                                    <MenuItem Header="Action 3" />
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </StackPanel>
                </ContentControl>

                <!-- ListBox -->
                <ContentControl Style="{StaticResource PlainCard}" Width="360" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="ListBox" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                        <ListBox Height="100">
                            <ListBoxItem Content="Item 1" />
                            <ListBoxItem Content="Item 2" />
                            <ListBoxItem Content="Item 3 (selected)" IsSelected="True" />
                            <ListBoxItem Content="Item 4" />
                        </ListBox>
                    </StackPanel>
                </ContentControl>

                <!-- TabControl -->
                <ContentControl Style="{StaticResource PlainCard}" Width="360" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="TabControl" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                        <TabControl Height="100">
                            <TabItem Header="Tab A">
                                <TextBlock Text="Content A" FontSize="13" Margin="8"
                                           Foreground="{DynamicResource ColorBrush1}" />
                            </TabItem>
                            <TabItem Header="Tab B">
                                <TextBlock Text="Content B" FontSize="13" Margin="8"
                                           Foreground="{DynamicResource ColorBrush1}" />
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ContentControl>

            </WrapPanel>

            <!-- Full-width cards below -->
            <!-- ListView -->
            <ContentControl Style="{StaticResource PlainCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ListView (GridView)" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                    <ListView ItemsSource="{Binding SampleData}" MaxHeight="160">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="120"
                                                DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Category" Width="100"
                                                DisplayMemberBinding="{Binding Category}" />
                                <GridViewColumn Header="Value" Width="80"
                                                DisplayMemberBinding="{Binding Value}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </ContentControl>

            <!-- DataGrid -->
            <ContentControl Style="{StaticResource PlainCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="DataGrid" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding SampleData}" Height="140"
                              AutoGenerateColumns="True" />
                </StackPanel>
            </ContentControl>

            <!-- Card demo (self-reference) -->
            <ContentControl Style="{StaticResource PlainCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Card" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,4" />
                    <TextBlock Text="PCL-CE MaterialCard with animated hover — border, shadow, and tint fade in smoothly."
                               FontSize="13" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,8"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Use PlainCard style on ContentControl. Hover to see the animation."
                               FontSize="12" Foreground="{DynamicResource ColorBrushGray3}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ContentControl>

        </StackPanel>
    </ScrollViewer>
</Window>

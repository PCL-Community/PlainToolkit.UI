<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Button" x:Key="PlainButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="FontSize" Value="13" />

        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushHalfWhite}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PanBack"
                            Background="{DynamicResource ColorBrushSemiTransparent}">
                        <Border x:Name="PanFore" CornerRadius="3" BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <TextBlock x:Name="LabText"
                                       Text="{TemplateBinding Content}"
                                       TextOptions.TextFormattingMode="Display"
                                       SnapsToDevicePixels="True" TextTrimming="None"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5"
                                       Foreground="{Binding BorderBrush, ElementName=PanFore}"
                                       FontSize="{TemplateBinding FontSize}"
                                       IsHitTestVisible="False">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: only background changes; BorderBrush keeps variant color -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PanFore" Property="Background" Value="{DynamicResource ColorBrushButtonHoverBg}" />
                        </Trigger>
                        <!-- Pressed: scale animation (color-independent) -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PanFore"
                                            Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="0.955" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="PanFore"
                                            Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="0.955" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PanFore"
                                            Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="1" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="PanFore"
                                            Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="1" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PanFore" Property="BorderBrush" Value="{DynamicResource ColorBrushGray4}" />
                            <Setter TargetName="PanFore" Property="Background" Value="{DynamicResource ColorBrushGray6}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource PlainButton}" />

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Mode Color Overrides — matches PCL-CE dark theme -->

    <!-- Color Brushes -->
    <SolidColorBrush x:Key="ColorBrush1">#cdd6f4</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrush2">#89b4fa</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrush3">#89b4fa</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrush4">#74c7ec</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrush5">#45475a</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrush6">#313244</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrush7">#2a2b3d</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrush8">#252638</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushBg0">#585b70</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushBg1">#802a2b3d</SolidColorBrush>

    <!-- Color Objects -->
    <Color x:Key="ColorObject1">#cdd6f4</Color>
    <Color x:Key="ColorObject2">#89b4fa</Color>
    <Color x:Key="ColorObject3">#89b4fa</Color>
    <Color x:Key="ColorObject4">#74c7ec</Color>
    <Color x:Key="ColorObject5">#45475a</Color>
    <Color x:Key="ColorObject6">#313244</Color>
    <Color x:Key="ColorObject7">#2a2b3d</Color>
    <Color x:Key="ColorObject8">#252638</Color>
    <Color x:Key="ColorObjectBg0">#585b70</Color>
    <Color x:Key="ColorObjectBg1">#802a2b3d</Color>
    <Color x:Key="ColorObjectMsgBoxShadow">#000000</Color>

    <!-- Gray Brushes (keep similar for dark mode) -->
    <SolidColorBrush x:Key="ColorBrushGray1">#cdd6f4</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushGray2">#a6adc8</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushGray3">#6c7086</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushGray4">#585b70</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushGray5">#45475a</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushGray6">#313244</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushGray7">#2a2b3d</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushGray8">#252638</SolidColorBrush>

    <!-- Gray Color Objects -->
    <Color x:Key="ColorObjectGray1">#cdd6f4</Color>
    <Color x:Key="ColorObjectGray2">#a6adc8</Color>
    <Color x:Key="ColorObjectGray3">#6c7086</Color>
    <Color x:Key="ColorObjectGray4">#585b70</Color>
    <Color x:Key="ColorObjectGray5">#45475a</Color>
    <Color x:Key="ColorObjectGray6">#313244</Color>
    <Color x:Key="ColorObjectGray7">#2a2b3d</Color>
    <Color x:Key="ColorObjectGray8">#252638</Color>

    <!-- Semantic Brushes -->
    <SolidColorBrush x:Key="ColorBrushRedBack">#8038323f</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushRedLight">#f38ba8</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushRedDark">#f38ba8</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushHalfWhite" Color="#55cdd6f4" />
    <SolidColorBrush x:Key="ColorBrushSemiWhite" Color="#bbcdd6f4" />
    <SolidColorBrush x:Key="ColorBrushWhite" Color="#1e1e2e" />
    <SolidColorBrush x:Key="ColorBrushTransparent" Color="#001e1e2e" />
    <SolidColorBrush x:Key="ColorBrushSemiTransparent">#011e1e2e</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushTransparentBackground" Color="#d21e1e2e" />
    <SolidColorBrush x:Key="ColorBrushBackground">#1e1e2e</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushToolTip">#e51e1e2e</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushMemory">#ffffff</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushFatal">#f38ba8</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushError">#f38ba8</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushWarn">#f9e2af</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushInfoDark">#000000</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushInfo">#cdd6f4</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushDebug">#6c7086</SolidColorBrush>

    <!-- ========== State-specific (dark mode) ========== -->
    <!-- Button hover/pressed -->
    <SolidColorBrush x:Key="ColorBrushButtonHoverBorder">#89b4fa</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushButtonHoverBg">#313244</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushButtonPressedBorder">#74c7ec</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushButtonPressedBg">#45475a</SolidColorBrush>

    <!-- Input hover/focus -->
    <SolidColorBrush x:Key="ColorBrushInputHoverBorder">#89b4fa</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushInputHoverBg">#313244</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushInputFocusBorder">#89b4fa</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushInputFocusBg">#313244</SolidColorBrush>

</ResourceDictionary>
